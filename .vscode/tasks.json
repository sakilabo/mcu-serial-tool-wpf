{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/mcu-serial-tool.sln",
                "--no-restore",
                "-c",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "build Release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/mcu-serial-tool.sln",
                "--no-restore",
                "-c",
                "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
