<Window x:Class="MCUSerialTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MCUSerialTool"
        Title="マイコンアプリ更新ツール"
        Width="1200"
        Height="600"
        MinWidth="1200"
        MinHeight="600"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Padding"
                            Value="6,4"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="このアプリについて(_A)..."
                          Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:PortGroup x:Name="PortPanel"
                             Grid.Column="0"
                             Grid.Row="0"/>
            <local:FirmwareGroup x:Name="FirmwarePanel"
                                 Grid.Column="0"
                                 Grid.Row="1"
                                 Margin="0"/>
            <local:SerialMonitorGroup x:Name="SerialMonitor"
                                      Grid.Column="2"
                                      Grid.RowSpan="2"
                                      Margin="0"/>
        </Grid>
    </DockPanel>
</Window>
