<GroupBox x:Class="MCUSerialTool.PortGroup"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Header="COM ポート"
          Style="{StaticResource GroupBoxStyle}">
    <GroupBox.Resources>
        <Thickness x:Key="DefaultCellPadding">4,3</Thickness>
        <Thickness x:Key="TypeCellPadding">4,3,12,3</Thickness>
    </GroupBox.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="RefreshPortsButton"
                Grid.Row="0"
                Margin="0,0,0,6"
                HorizontalAlignment="Right"
                Content="更新"/>
        <DataGrid x:Name="PortList"
                  Grid.Row="1"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="#E6E6E6"
                  VerticalGridLinesBrush="Transparent"
                  IsReadOnly="True"
                  IsTabStop="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Resources>
                <Style x:Key="DataGridTextStyle"
                       TargetType="{x:Type TextBlock}">
                    <Setter Property="Margin"
                            Value="{StaticResource DefaultCellPadding}"/>
                    <Setter Property="VerticalAlignment"
                            Value="Center"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="BorderBrush"
                            Value="#D0D0D0"/>
                    <Setter Property="BorderThickness"
                            Value="0,0,0,1"/>
                    <Setter Property="Padding"
                            Value="{StaticResource DefaultCellPadding}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness"
                            Value="0"/>
                    <Setter Property="FocusVisualStyle"
                            Value="{x:Null}"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header=""
                                    Width="32">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource DataGridTextStyle}">
                            <Setter Property="Text"
                                    Value="●"/>
                            <Setter Property="HorizontalAlignment"
                                    Value="Center"/>
                            <Setter Property="Foreground"
                                    Value="#E0E0E0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}"
                                             Value="Programming">
                                    <Setter Property="Foreground"
                                            Value="LightBlue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mode}"
                                             Value="SerialMonitor">
                                    <Setter Property="Foreground"
                                            Value="LightGreen"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ポート"
                                    Binding="{Binding Port}"
                                    ElementStyle="{StaticResource DataGridTextStyle}"
                                    Width="80"/>
                <DataGridTextColumn Header="デバイス"
                                    Binding="{Binding Name}"
                                    ElementStyle="{StaticResource DataGridTextStyle}"
                                    Width="*"/>
                <DataGridTextColumn Header="種別"
                                    Binding="{Binding MCUDisplay}"
                                    MinWidth="100"
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource DataGridTextStyle}">
                            <Setter Property="Margin"
                                    Value="{StaticResource TypeCellPadding}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</GroupBox>
