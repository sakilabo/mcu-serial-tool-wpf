<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MCUSerialTool</RootNamespace>
    <AssemblyName>マイコンアプリ更新ツール</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>icon\Icon.ico</ApplicationIcon>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon\128.png">
      <Link>Icon.png</Link>
    </Resource>
    <EmbeddedResource Include="..\LICENSE">
      <Link>LICENSE</Link>
      <LogicalName>MCUSerialTool.License.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="FTD2XX_NET_SRC_v1.3.4\License.txt">
      <LogicalName>FTD2XX_NET.License.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
